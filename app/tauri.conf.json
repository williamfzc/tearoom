{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tearoom",
  "version": "0.2.0",
  "identifier": "app.tearoom.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tearoom",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns"]
  }
}
