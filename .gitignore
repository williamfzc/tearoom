# Build outputs are reproducible from source via `make build`, so committing them
# would only create merge conflicts.
bin/
target/

# Tauri codegen writes JSON schemas here at build time; `app/capabilities/`
# is the checked-in source they describe.
app/gen/

# The project's own workspace is local working state, not committed history
# (owner decision 2026-11-09): its records live on this machine and stay
# append-only there.
.tearoom/

.DS_Store

